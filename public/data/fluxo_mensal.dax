EVALUATE

VAR Resultado =
    SUMMARIZECOLUMNS(
        dN4[N4],
        dProjetos[NomeLB],
        dCalendarioCaixa[Ano],
        dCalendarioCaixa[Mês],

        // Escopo organizacional
        FILTER(
            ALL(dN4[N3]),
            dN4[N3] = "Plataformas De Produção"
        ),

        // Fluxo mensal atual do portal
        FILTER(
            ALL(dCalendarioCaixa[Ano]),
            dCalendarioCaixa[Ano] = 2026
        ),

        // Regra oficial da carteira: somente CAPEX
        FILTER(
            ALL(dNatureza[Natureza]),
            dNatureza[Natureza] = "CAPEX"
        ),

        // Exclusão mantida por compatibilidade com o relatório
        FILTER(
            ALL(dRCs[REQ_COMPRA]),
            dRCs[REQ_COMPRA] <> "RCGRJ10523844"
        ),

        "Realizado_Pago",
            [Realizado Pago]
    )

RETURN
    FILTER(
        Resultado,
        NOT ISBLANK([Realizado_Pago])
    )

ORDER BY
    dN4[N4],
    dProjetos[NomeLB],
    dCalendarioCaixa[Ano],
    dCalendarioCaixa[Mês]