{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["api/**/*.ts"],
  "exclude": ["api/**/*.test.ts", "api/_lib/testDb.ts", "api/_lib/testHttp.ts"]
}
